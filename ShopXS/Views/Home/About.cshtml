@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-6">
            <h1 class="display-5 fw-bold">About ShopXS</h1>
            <p class="lead">Your trusted e-commerce destination for quality products at affordable prices.</p>
            <p>ShopXS is a modern e-commerce platform inspired by leading marketplaces like Amazon, Alibaba, and Daraz. We bring together buyers and sellers from around the world, providing a seamless shopping experience with features like:</p>
            <ul>
                <li>Wide variety of products across multiple categories</li>
                <li>Secure payment processing</li>
                <li>Fast and reliable shipping</li>
                <li>Seller marketplace for entrepreneurs</li>
                <li>24/7 customer support</li>
            </ul>
        </div>
        <div class="col-lg-6">
            <div class="bg-primary text-white p-5 rounded shadow">
                <h3>Our Mission</h3>
                <p>To provide an accessible, affordable, and reliable shopping experience for everyone, while empowering sellers to grow their businesses.</p>
                <h3 class="mt-4">Our Vision</h3>
                <p class="mb-0">To become the leading e-commerce platform that connects communities through commerce.</p>
            </div>
        </div>
    </div>

    <div class="row mt-5 text-center">
        <div class="col-md-4">
            <div class="p-4">
                <i class="bi bi-people fs-1 text-primary"></i>
                <h3 class="mt-3">10,000+</h3>
                <p class="text-muted">Happy Customers</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4">
                <i class="bi bi-shop fs-1 text-primary"></i>
                <h3 class="mt-3">500+</h3>
                <p class="text-muted">Verified Sellers</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4">
                <i class="bi bi-box fs-1 text-primary"></i>
                <h3 class="mt-3">50,000+</h3>
                <p class="text-muted">Products Available</p>
            </div>
        </div>
    </div>
</div>
