@{
    ViewData["Title"] = "Contact Us";
}

<div class="container py-5">
    <div class="row">
        <div class="col-lg-6">
            <h1 class="display-5 fw-bold">Contact Us</h1>
            <p class="lead">We'd love to hear from you. Get in touch with us!</p>

            <div class="mt-4">
                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <i class="bi bi-geo-alt fs-2 text-primary"></i>
                    </div>
                    <div class="ms-3">
                        <h5>Address</h5>
                        <p class="text-muted">123 Shopping Street, Commerce City, CC 12345</p>
                    </div>
                </div>

                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <i class="bi bi-telephone fs-2 text-primary"></i>
                    </div>
                    <div class="ms-3">
                        <h5>Phone</h5>
                        <p class="text-muted">+1 234 567 890</p>
                    </div>
                </div>

                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <i class="bi bi-envelope fs-2 text-primary"></i>
                    </div>
                    <div class="ms-3">
                        <h5>Email</h5>
                        <p class="text-muted">support@shopxs.com</p>
                    </div>
                </div>

                <div class="d-flex mb-4">
                    <div class="flex-shrink-0">
                        <i class="bi bi-clock fs-2 text-primary"></i>
                    </div>
                    <div class="ms-3">
                        <h5>Business Hours</h5>
                        <p class="text-muted">Monday - Friday: 9:00 AM - 6:00 PM<br>Saturday: 10:00 AM - 4:00 PM</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card border-0 shadow">
                <div class="card-body p-5">
                    <h4 class="mb-4">Send us a message</h4>
                    <form>
                        <div class="mb-3">
                            <label class="form-label">Your Name</label>
                            <input type="text" class="form-control" placeholder="John Doe">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email Address</label>
                            <input type="email" class="form-control" placeholder="john@example.com">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Subject</label>
                            <input type="text" class="form-control" placeholder="How can we help?">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Message</label>
                            <textarea class="form-control" rows="4" placeholder="Your message..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-send"></i> Send Message
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
