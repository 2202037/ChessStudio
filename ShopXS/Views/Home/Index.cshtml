@model ShopXS.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section text-center">
    <div class="container">
        <h1 class="display-4 fw-bold mb-3">Welcome to ShopXS</h1>
        <p class="lead mb-4">Discover amazing products at unbeatable prices. Shop now and enjoy free shipping on orders over $50!</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-light btn-lg me-2">
            <i class="bi bi-bag"></i> Shop Now
        </a>
        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg">
            <i class="bi bi-person-plus"></i> Join Us
        </a>
    </div>
</section>

<!-- Categories Section -->
<section class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center mb-4">Shop by Category</h2>
        <div class="row g-4">
            @foreach (var category in Model.Categories.Take(5))
            {
                <div class="col-6 col-md-4 col-lg">
                    <a asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id" class="text-decoration-none">
                        <div class="category-card p-4 text-center h-100">
                            <i class="bi bi-grid-3x3-gap fs-1 mb-2"></i>
                            <h5 class="mb-0">@category.Name</h5>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- Featured Products Section -->
<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Featured Products</h2>
            <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary">View All <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="row g-4">
            @if (Model.FeaturedProducts.Any())
            {
                @foreach (var product in Model.FeaturedProducts)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="card product-card h-100 border-0 shadow-sm">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" class="card-img-top" alt="@product.Title" style="height: 200px; object-fit: cover;">
                            }
                            else
                            {
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                                    <i class="bi bi-image fs-1"></i>
                                </div>
                            }
                            <div class="card-body">
                                <h6 class="card-title text-truncate">@product.Title</h6>
                                <p class="card-text text-muted small">@product.Category.Name</p>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        @if (product.DiscountPrice.HasValue)
                                        {
                                            <span class="price">$@product.DiscountPrice.Value.ToString("F2")</span>
                                            <span class="original-price ms-2">$@product.Price.ToString("F2")</span>
                                        }
                                        else
                                        {
                                            <span class="price">$@product.Price.ToString("F2")</span>
                                        }
                                    </div>
                                    <div class="rating">
                                        @for (int i = 0; i < 5; i++)
                                        {
                                            if (i < Math.Round(product.AverageRating))
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-star"></i>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                            <div class="card-footer bg-white border-0">
                                <a asp-controller="Products" asp-action="Details" asp-route-id="@product.Id" class="btn btn-primary w-100">
                                    <i class="bi bi-eye"></i> View Details
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-box-seam fs-1 text-muted"></i>
                    <p class="text-muted mt-3">No featured products yet. Check back soon!</p>
                </div>
            }
        </div>
    </div>
</section>

