@model ShopXS.Models.Entities.Order
@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="bi bi-check-circle-fill text-success display-1"></i>
                    <h2 class="mt-3">Order Placed Successfully!</h2>
                    <p class="text-muted">Thank you for your order. We've received your order and will process it soon.</p>
                    <p class="mb-4">
                        <strong>Order Number:</strong> 
                        <span class="badge bg-primary fs-6">@Model.OrderNumber</span>
                    </p>
                </div>
            </div>

            <div class="card border-0 shadow-sm mt-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-receipt"></i> Order Details</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Order Date:</strong>
                            <p class="text-muted mb-0">@Model.CreatedAt.ToString("MMMM dd, yyyy")</p>
                        </div>
                        <div class="col-6">
                            <strong>Status:</strong>
                            <p class="mb-0"><span class="badge bg-warning">@Model.Status</span></p>
                        </div>
                    </div>

                    <hr>

                    <h6>Items Ordered</h6>
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <div>
                                <span>@item.Product.Title</span>
                                <span class="text-muted small"> x @item.Quantity</span>
                            </div>
                            <span>$@item.TotalPrice.ToString("F2")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between py-2">
                        <span>Subtotal</span>
                        <span>$@Model.SubTotal.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span>Shipping</span>
                        <span>$@Model.ShippingCost.ToString("F2")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2">
                        <span>Tax</span>
                        <span>$@Model.Tax.ToString("F2")</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between py-2">
                        <strong>Total</strong>
                        <strong class="text-primary fs-5">$@Model.TotalAmount.ToString("F2")</strong>
                    </div>

                    <hr>

                    <h6>Shipping Address</h6>
                    <p class="text-muted mb-0">
                        @Model.ShippingName<br>
                        @Model.ShippingAddress<br>
                        @Model.ShippingCity, @Model.ShippingCountry @Model.ShippingPostalCode<br>
                        Phone: @Model.ShippingPhone
                    </p>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-controller="Order" asp-action="Index" class="btn btn-outline-primary me-2">
                    <i class="bi bi-bag"></i> View All Orders
                </a>
                <a asp-controller="Products" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-cart"></i> Continue Shopping
                </a>
            </div>
        </div>
    </div>
</div>
