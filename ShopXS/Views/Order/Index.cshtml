@model IEnumerable<ShopXS.Models.Entities.Order>
@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-4">
    <h2 class="mb-4"><i class="bi bi-bag"></i> My Orders</h2>

    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Order #</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td><strong>@order.OrderNumber</strong></td>
                                <td>@order.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>@order.OrderItems.Sum(oi => oi.Quantity) items</td>
                                <td><strong class="text-primary">$@order.TotalAmount.ToString("F2")</strong></td>
                                <td>
                                    @switch (order.Status)
                                    {
                                        case ShopXS.Models.Entities.OrderStatus.Pending:
                                            <span class="badge bg-warning">Pending</span>
                                            break;
                                        case ShopXS.Models.Entities.OrderStatus.Confirmed:
                                            <span class="badge bg-info">Confirmed</span>
                                            break;
                                        case ShopXS.Models.Entities.OrderStatus.Processing:
                                            <span class="badge bg-primary">Processing</span>
                                            break;
                                        case ShopXS.Models.Entities.OrderStatus.Shipped:
                                            <span class="badge bg-info">Shipped</span>
                                            break;
                                        case ShopXS.Models.Entities.OrderStatus.Delivered:
                                            <span class="badge bg-success">Delivered</span>
                                            break;
                                        case ShopXS.Models.Entities.OrderStatus.Cancelled:
                                            <span class="badge bg-danger">Cancelled</span>
                                            break;
                                        case ShopXS.Models.Entities.OrderStatus.Refunded:
                                            <span class="badge bg-secondary">Refunded</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-bag-x display-1 text-muted"></i>
            <h3 class="mt-3">No orders yet</h3>
            <p class="text-muted">You haven't placed any orders yet.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-bag"></i> Start Shopping
            </a>
        </div>
    }
</div>
