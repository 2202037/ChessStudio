@model ShopXS.Models.ViewModels.ProductDetailViewModel
@{
    ViewData["Title"] = Model.Product.Title;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Products</a></li>
            <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index" asp-route-categoryId="@Model.Product.CategoryId">@Model.Product.Category.Name</a></li>
            <li class="breadcrumb-item active">@Model.Product.Title</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Product Images -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm">
                @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                {
                    <img src="@Model.Product.ImageUrl" class="card-img-top" alt="@Model.Product.Title" style="max-height: 500px; object-fit: contain;">
                }
                else
                {
                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 400px;">
                        <i class="bi bi-image display-1"></i>
                    </div>
                }
            </div>
        </div>

        <!-- Product Details -->
        <div class="col-md-6">
            <h1 class="h2">@Model.Product.Title</h1>
            
            <!-- Rating -->
            <div class="d-flex align-items-center mb-3">
                <div class="rating me-2">
                    @for (int i = 0; i < 5; i++)
                    {
                        if (i < Math.Round(Model.Product.AverageRating))
                        {
                            <i class="bi bi-star-fill"></i>
                        }
                        else
                        {
                            <i class="bi bi-star"></i>
                        }
                    }
                </div>
                <span class="text-muted">(@Model.Product.ReviewCount reviews)</span>
            </div>

            <!-- Price -->
            <div class="mb-3">
                @if (Model.Product.DiscountPrice.HasValue)
                {
                    <span class="display-6 text-primary fw-bold">$@Model.Product.DiscountPrice.Value.ToString("F2")</span>
                    <span class="h4 text-muted text-decoration-line-through ms-2">$@Model.Product.Price.ToString("F2")</span>
                    <span class="badge bg-danger ms-2">
                        @(Math.Round((1 - (Model.Product.DiscountPrice.Value / Model.Product.Price)) * 100))% OFF
                    </span>
                }
                else
                {
                    <span class="display-6 text-primary fw-bold">$@Model.Product.Price.ToString("F2")</span>
                }
            </div>

            <!-- Stock Status -->
            <div class="mb-3">
                @if (Model.Product.Stock > 10)
                {
                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> In Stock (@Model.Product.Stock available)</span>
                }
                else if (Model.Product.Stock > 0)
                {
                    <span class="badge bg-warning"><i class="bi bi-exclamation-circle"></i> Low Stock (Only @Model.Product.Stock left)</span>
                }
                else
                {
                    <span class="badge bg-danger"><i class="bi bi-x-circle"></i> Out of Stock</span>
                }
            </div>

            <!-- Description -->
            <div class="mb-4">
                <h5>Description</h5>
                <p class="text-muted">@(Model.Product.Description ?? "No description available.")</p>
            </div>

            <!-- Add to Cart -->
            @if (Model.Product.Stock > 0)
            {
                <form asp-controller="Cart" asp-action="Add" method="post" class="mb-4">
                    <input type="hidden" name="productId" value="@Model.Product.Id" />
                    <div class="row g-3 align-items-center">
                        <div class="col-auto">
                            <label class="form-label mb-0">Quantity:</label>
                        </div>
                        <div class="col-auto">
                            <input type="number" name="quantity" value="1" min="1" max="@Model.Product.Stock" class="form-control" style="width: 80px;">
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-cart-plus"></i> Add to Cart
                            </button>
                        </div>
                    </div>
                </form>
            }

            <!-- Product Info -->
            <div class="card bg-light border-0">
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <p class="mb-1"><strong>Category:</strong></p>
                            <p class="text-muted">@Model.Product.Category.Name</p>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Product.SKU))
                        {
                            <div class="col-6">
                                <p class="mb-1"><strong>SKU:</strong></p>
                                <p class="text-muted">@Model.Product.SKU</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews Section -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white">
                    <h4 class="mb-0"><i class="bi bi-chat-left-text"></i> Customer Reviews (@Model.Reviews.Count)</h4>
                </div>
                <div class="card-body">
                    @if (Model.Reviews.Any())
                    {
                        @foreach (var review in Model.Reviews)
                        {
                            <div class="border-bottom pb-3 mb-3">
                                <div class="d-flex justify-content-between">
                                    <div>
                                        <strong>@review.User.FirstName @review.User.LastName</strong>
                                        <div class="rating small">
                                            @for (int i = 0; i < 5; i++)
                                            {
                                                if (i < review.Rating)
                                                {
                                                    <i class="bi bi-star-fill"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star"></i>
                                                }
                                            }
                                        </div>
                                    </div>
                                    <small class="text-muted">@review.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                                @if (!string.IsNullOrEmpty(review.Title))
                                {
                                    <h6 class="mt-2">@review.Title</h6>
                                }
                                <p class="text-muted mb-0">@review.Comment</p>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="bi bi-chat-left display-4 text-muted"></i>
                            <p class="text-muted mt-2">No reviews yet. Be the first to review this product!</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (Model.RelatedProducts.Any())
    {
        <div class="row mt-5">
            <div class="col-12">
                <h4 class="mb-4">Related Products</h4>
                <div class="row g-4">
                    @foreach (var product in Model.RelatedProducts)
                    {
                        <div class="col-6 col-md-3">
                            <div class="card product-card h-100 border-0 shadow-sm">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Title" style="height: 150px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 150px;">
                                        <i class="bi bi-image fs-1"></i>
                                    </div>
                                }
                                <div class="card-body">
                                    <h6 class="card-title text-truncate">@product.Title</h6>
                                    <span class="price">$@((product.DiscountPrice ?? product.Price).ToString("F2"))</span>
                                </div>
                                <div class="card-footer bg-white border-0">
                                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm w-100">View Details</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>
