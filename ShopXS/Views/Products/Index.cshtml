@model ShopXS.Models.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = "Products";
}

<div class="container py-4">
    <div class="row">
        <!-- Sidebar Filters -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white">
                    <h6 class="mb-0"><i class="bi bi-funnel"></i> Filters</h6>
                </div>
                <div class="card-body">
                    <form asp-action="Index" method="get">
                        <!-- Categories -->
                        <div class="mb-4">
                            <h6>Categories</h6>
                            <div class="list-group list-group-flush">
                                <a asp-action="Index" class="list-group-item list-group-item-action @(Model.SelectedCategoryId == null ? "active" : "")">
                                    All Categories
                                </a>
                                @foreach (var category in Model.Categories)
                                {
                                    <a asp-action="Index" asp-route-categoryId="@category.Id" asp-route-search="@Model.SearchTerm"
                                       class="list-group-item list-group-item-action @(Model.SelectedCategoryId == category.Id ? "active" : "")">
                                        @category.Name
                                    </a>
                                }
                            </div>
                        </div>

                        <!-- Price Range -->
                        <div class="mb-4">
                            <h6>Price Range</h6>
                            <div class="row g-2">
                                <div class="col-6">
                                    <input type="number" name="minPrice" class="form-control form-control-sm" placeholder="Min" value="@Model.MinPrice">
                                </div>
                                <div class="col-6">
                                    <input type="number" name="maxPrice" class="form-control form-control-sm" placeholder="Max" value="@Model.MaxPrice">
                                </div>
                            </div>
                        </div>

                        <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                        <input type="hidden" name="search" value="@Model.SearchTerm" />
                        <input type="hidden" name="sort" value="@Model.SortBy" />

                        <button type="submit" class="btn btn-primary w-100">Apply Filters</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Products Grid -->
        <div class="col-md-9">
            <!-- Search and Sort Bar -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-6">
                            <form asp-action="Index" method="get" class="d-flex">
                                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                                <input type="text" name="search" class="form-control me-2" placeholder="Search products..." value="@Model.SearchTerm">
                                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i></button>
                            </form>
                        </div>
                        <div class="col-md-6 text-end">
                            <span class="text-muted me-3">@Model.TotalItems products found</span>
                            <div class="btn-group">
                                <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm" asp-route-sort="newest"
                                   class="btn btn-outline-secondary btn-sm @(Model.SortBy == "newest" || Model.SortBy == null ? "active" : "")">Newest</a>
                                <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm" asp-route-sort="price_asc"
                                   class="btn btn-outline-secondary btn-sm @(Model.SortBy == "price_asc" ? "active" : "")">Price ↑</a>
                                <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm" asp-route-sort="price_desc"
                                   class="btn btn-outline-secondary btn-sm @(Model.SortBy == "price_desc" ? "active" : "")">Price ↓</a>
                                <a asp-action="Index" asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm" asp-route-sort="rating"
                                   class="btn btn-outline-secondary btn-sm @(Model.SortBy == "rating" ? "active" : "")">Rating</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Products -->
            <div class="row g-4">
                @if (Model.Products.Any())
                {
                    @foreach (var product in Model.Products)
                    {
                        <div class="col-6 col-lg-4">
                            <div class="card product-card h-100 border-0 shadow-sm">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" class="card-img-top" alt="@product.Title" style="height: 200px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                                        <i class="bi bi-image fs-1"></i>
                                    </div>
                                }
                                @if (product.Stock < 5 && product.Stock > 0)
                                {
                                    <span class="badge bg-warning position-absolute top-0 end-0 m-2">Low Stock</span>
                                }
                                else if (product.Stock == 0)
                                {
                                    <span class="badge bg-danger position-absolute top-0 end-0 m-2">Out of Stock</span>
                                }
                                <div class="card-body">
                                    <h6 class="card-title text-truncate">@product.Title</h6>
                                    <p class="card-text text-muted small">@product.Category.Name</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            @if (product.DiscountPrice.HasValue)
                                            {
                                                <span class="price">$@product.DiscountPrice.Value.ToString("F2")</span>
                                                <span class="original-price ms-2">$@product.Price.ToString("F2")</span>
                                            }
                                            else
                                            {
                                                <span class="price">$@product.Price.ToString("F2")</span>
                                            }
                                        </div>
                                        <div class="rating">
                                            @for (int i = 0; i < 5; i++)
                                            {
                                                if (i < Math.Round(product.AverageRating))
                                                {
                                                    <i class="bi bi-star-fill"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-star"></i>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer bg-white border-0 d-grid gap-2">
                                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">
                                        <i class="bi bi-eye"></i> View Details
                                    </a>
                                    @if (product.Stock > 0)
                                    {
                                        <form asp-controller="Cart" asp-action="Add" method="post">
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="btn btn-primary btn-sm w-100">
                                                <i class="bi bi-cart-plus"></i> Add to Cart
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <i class="bi bi-search display-1 text-muted"></i>
                        <h4 class="mt-3">No products found</h4>
                        <p class="text-muted">Try adjusting your search or filter criteria</p>
                        <a asp-action="Index" class="btn btn-primary">View All Products</a>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav class="mt-4">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm" asp-route-sort="@Model.SortBy">Previous</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(Model.CurrentPage == i ? "active" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@i"
                                   asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm" asp-route-sort="@Model.SortBy">@i</a>
                            </li>
                        }
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-categoryId="@Model.SelectedCategoryId" asp-route-search="@Model.SearchTerm" asp-route-sort="@Model.SortBy">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>
