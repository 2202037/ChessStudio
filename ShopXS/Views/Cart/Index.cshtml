@model ShopXS.Models.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Shopping Cart";
}

<div class="container py-4">
    <h2 class="mb-4"><i class="bi bi-cart3"></i> Shopping Cart</h2>

    @if (Model.Items.Any())
    {
        <div class="row">
            <!-- Cart Items -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        @foreach (var item in Model.Items)
                        {
                            <div class="row align-items-center py-3 border-bottom">
                                <div class="col-md-2">
                                    @if (!string.IsNullOrEmpty(item.ProductImage))
                                    {
                                        <img src="@item.ProductImage" class="img-fluid rounded" alt="@item.ProductTitle">
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded" style="height: 80px;">
                                            <i class="bi bi-image"></i>
                                        </div>
                                    }
                                </div>
                                <div class="col-md-4">
                                    <h6 class="mb-1">@item.ProductTitle</h6>
                                    <p class="text-muted small mb-0">Unit Price: $@item.UnitPrice.ToString("F2")</p>
                                </div>
                                <div class="col-md-3">
                                    <form asp-action="UpdateQuantity" method="post" class="d-flex align-items-center">
                                        <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                        <div class="input-group input-group-sm" style="width: 120px;">
                                            <button type="button" class="btn btn-outline-secondary" onclick="updateQty(this, -1)">-</button>
                                            <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.MaxQuantity" class="form-control text-center qty-input">
                                            <button type="button" class="btn btn-outline-secondary" onclick="updateQty(this, 1)">+</button>
                                        </div>
                                        <button type="submit" class="btn btn-link btn-sm ms-2"><i class="bi bi-arrow-repeat"></i></button>
                                    </form>
                                </div>
                                <div class="col-md-2 text-end">
                                    <strong class="text-primary">$@item.TotalPrice.ToString("F2")</strong>
                                </div>
                                <div class="col-md-1 text-end">
                                    <form asp-action="Remove" method="post">
                                        <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                                        <button type="submit" class="btn btn-link text-danger btn-sm p-0">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary">
                        <i class="bi bi-arrow-left"></i> Continue Shopping
                    </a>
                    <form asp-action="Clear" method="post">
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-trash"></i> Clear Cart
                        </button>
                    </form>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Order Summary</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal (@Model.Items.Sum(i => i.Quantity) items)</span>
                            <span>$@Model.SubTotal.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping</span>
                            <span>$@Model.ShippingCost.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax (10%)</span>
                            <span>$@Model.Tax.ToString("F2")</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <strong>Total</strong>
                            <strong class="text-primary fs-4">$@Model.Total.ToString("F2")</strong>
                        </div>
                        <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary w-100 btn-lg">
                            <i class="bi bi-lock"></i> Proceed to Checkout
                        </a>
                    </div>
                </div>

                <!-- Promo Code -->
                <div class="card border-0 shadow-sm mt-3">
                    <div class="card-body">
                        <h6><i class="bi bi-tag"></i> Promo Code</h6>
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Enter code">
                            <button class="btn btn-outline-primary" type="button">Apply</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h3 class="mt-3">Your cart is empty</h3>
            <p class="text-muted">Looks like you haven't added anything to your cart yet.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-bag"></i> Start Shopping
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function updateQty(btn, delta) {
            var input = btn.parentElement.querySelector('.qty-input');
            var newVal = parseInt(input.value) + delta;
            var max = parseInt(input.max);
            if (newVal >= 1 && newVal <= max) {
                input.value = newVal;
            }
        }
    </script>
}
