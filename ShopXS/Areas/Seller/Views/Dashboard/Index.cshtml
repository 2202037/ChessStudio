@model SellerDashboardViewModel
@{
    ViewData["Title"] = "Seller Dashboard";
}

<!-- Stats Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted">Total Products</h6>
                        <h3 class="mb-0">@Model.TotalProducts</h3>
                    </div>
                    <i class="bi bi-box fs-1 text-success"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted">Total Orders</h6>
                        <h3 class="mb-0">@Model.TotalOrders</h3>
                    </div>
                    <i class="bi bi-bag fs-1 text-primary"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted">Total Revenue</h6>
                        <h3 class="mb-0">$@Model.TotalRevenue.ToString("N2")</h3>
                    </div>
                    <i class="bi bi-currency-dollar fs-1 text-warning"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted">Monthly Revenue</h6>
                        <h3 class="mb-0">$@Model.MonthlyRevenue.ToString("N2")</h3>
                    </div>
                    <i class="bi bi-graph-up fs-1 text-info"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body text-center">
                <h2>@Model.ApprovedProducts</h2>
                <p class="mb-0">Approved Products</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-warning text-white">
            <div class="card-body text-center">
                <h2>@Model.PendingProducts</h2>
                <p class="mb-0">Pending Approval</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm bg-info text-white">
            <div class="card-body text-center">
                <h2>@Model.PendingOrders</h2>
                <p class="mb-0">Pending Orders</p>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0"><i class="bi bi-lightning"></i> Quick Actions</h5>
    </div>
    <div class="card-body">
        <a asp-controller="Products" asp-action="Create" class="btn btn-success me-2">
            <i class="bi bi-plus-circle"></i> Add New Product
        </a>
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary me-2">
            <i class="bi bi-box"></i> Manage Products
        </a>
        <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-info">
            <i class="bi bi-bag"></i> View Orders
        </a>
    </div>
</div>

<!-- Recent Orders -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-clock-history"></i> Recent Orders</h5>
        <a asp-controller="Orders" asp-action="Index" class="btn btn-outline-primary btn-sm">View All</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Order #</th>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>Total</th>
                    <th>Status</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentOrders.Any())
                {
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr>
                            <td><strong>@order.OrderNumber</strong></td>
                            <td>@order.ProductTitle</td>
                            <td>@order.Quantity</td>
                            <td class="text-success">$@order.Total.ToString("F2")</td>
                            <td>
                                <span class="badge bg-@(order.Status == "Pending" ? "warning" : order.Status == "Delivered" ? "success" : "info")">
                                    @order.Status
                                </span>
                            </td>
                            <td>@order.CreatedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No orders yet</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
