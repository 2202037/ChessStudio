@model IEnumerable<Product>
@{
    ViewData["Title"] = "My Products";
}

<div class="mb-4">
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Add New Product
    </a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Image</th>
                    <th>Title</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th>Stock</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.Title" style="width: 50px; height: 50px; object-fit: cover;" class="rounded">
                                }
                                else
                                {
                                    <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded" style="width: 50px; height: 50px;">
                                        <i class="bi bi-image"></i>
                                    </div>
                                }
                            </td>
                            <td>@product.Title</td>
                            <td>@product.Category.Name</td>
                            <td>$@product.Price.ToString("F2")</td>
                            <td>
                                @if (product.Stock > 10)
                                {
                                    <span class="badge bg-success">@product.Stock</span>
                                }
                                else if (product.Stock > 0)
                                {
                                    <span class="badge bg-warning">@product.Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">0</span>
                                }
                            </td>
                            <td>
                                @if (product.IsApproved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">Pending</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?')">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-4">
                            <i class="bi bi-box display-4 text-muted"></i>
                            <p class="mt-2">No products yet. <a asp-action="Create">Add your first product</a></p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
